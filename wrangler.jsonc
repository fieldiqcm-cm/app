{
  "name": "app",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "VIDEOS", "bucket_name": "fieldiq-videos" }
  ]
}
